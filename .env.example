# Copy this file to `.env` and fill in what you use. Every variable here is
# read by env_config.py — nothing else is read, and everything read is
# documented here (a test asserts the two sets match in both directions).
#
# Precedence: an explicit CLI flag always wins > an exported environment
# variable > this file > the flag's own default. Credentials never belong
# on the command line — that's what this file (or an exported env var) is for.

# 2Captcha API key — shared across captcha solving, the Scraping Browser
# API, the Scraper API and the Fingerprint API (separately billed products
# behind one key; proxies are the same key too, billed as 2captcha.com/proxy — 2prx.com
# is a synonym for that product, not a separate service/host).
# Get one at https://2captcha.com/setting
# Needed for --scraper-api and --fingerprint. Over
# PERPLEXITY_CDP_ENDPOINT (the recommended setup, see README) the Browser
# API handles Cloudflare itself.
TWOCAPTCHA_KEY=

# A proxy for the local engines (Playwright/Selenium/pyppeteer launching
# their own browser) — e.g. http://login:password@host:port, from
# 2captcha.com/proxy. Leave blank to scrape from this machine's own IP.
PERPLEXITY_PROXY=

# A ready-made CDP connection string — most commonly a 2Captcha Scraping
# Browser API session: ws://{login}-zone-scraping_browser-country-{cc}-pid-
# {profileId}:{password}@cb.2captcha.com:9222 (see scraper_api_client.py).
# RECOMMENDED — see README "Recommended setup": on 2026-09-30 Cloudflare
# blocked every local browser tried, while this path scraped cleanly. Selenium CANNOT use one that
# carries credentials (see selenium_scraper.py's module docstring) — use
# playwright_scraper.py or puppeteer_scraper.py instead.
PERPLEXITY_CDP_ENDPOINT=

# Optional convenience default for --url, if you always scrape the same
# single article. There is no equivalent for --urls-file.
PERPLEXITY_URL=
